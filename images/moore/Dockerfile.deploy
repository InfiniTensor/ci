ARG BASE_IMAGE=sh-harbor.mthreads.com/mcctest/vllm_musa:20251112_hygon
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    http_proxy=${http_proxy} \
    https_proxy=${https_proxy}

ARG APT_MIRROR
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s|http://[^/]*/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        cmake \
        ninja-build \
        curl \
        tar \
        build-essential \
        pkg-config \
        python3-dev \
        ca-certificates \
        libboost-dev \
        libboost-stacktrace-dev \
        libffi-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_INDEX_URL
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        transformers \
        pyyaml \
        uvicorn \
        janus \
        fastapi \
        openai \
        pybind11 \
        xxhash \
        ml_dtypes \
        datasets

ENV XMAKE_ROOT=y
RUN curl -fsSL https://xmake.io/shget.text | bash
ENV PATH="/root/.local/bin:/root/.xmake/bin:${PATH}"

ENV INFINI_ROOT="/root/.infini"
ENV LD_LIBRARY_PATH="$INFINI_ROOT/lib:$LD_LIBRARY_PATH"
ENV PYTHONPATH="/root/.infini/lib:$PYTHONPATH"

WORKDIR /workspace

# Pin third_party deps in a stable cache layer; only rebuilds when SHAs change.
# json/spdlog are fetched here once (via build proxy); later stages clone locally from cache only.
ARG FLASH_ATTENTION_SHA=10846960ca0793b993446f6dbaf696479c127a9d
ARG CUTLASS_SHA=087c84df83d254b5fb295a7a408f1a1d554085cf
ARG INFINICORE_NLOHMANN_JSON_SHA=55f93686c01528224f448c19128836e7df245f72
ARG INFINICORE_SPDLOG_SHA=f1d748e5e3edfa4b1778edea003bac94781bc7b7
ARG INFINILM_JSON_SHA=5ed07097faa6c50199c4a3b66e5ed37d4fbfccc2
ARG INFINILM_SPDLOG_SHA=88a0e07ad5bb3e2651cd5613530b3f06a15fc400
RUN mkdir -p /opt/third_party_cache && \
    git clone https://github.com/Dao-AILab/flash-attention.git /opt/third_party_cache/flash-attention && \
    git -C /opt/third_party_cache/flash-attention checkout ${FLASH_ATTENTION_SHA} && \
    git clone https://github.com/NVIDIA/cutlass.git /opt/third_party_cache/cutlass && \
    git -C /opt/third_party_cache/cutlass checkout ${CUTLASS_SHA} && \
    git clone https://github.com/nlohmann/json.git /opt/third_party_cache/json && \
    git clone https://github.com/gabime/spdlog.git /opt/third_party_cache/spdlog && \
    for sha in ${INFINICORE_NLOHMANN_JSON_SHA} ${INFINILM_JSON_SHA}; do \
      git -C /opt/third_party_cache/json fetch --depth 1 origin "${sha}"; \
    done && \
    for sha in ${INFINICORE_SPDLOG_SHA} ${INFINILM_SPDLOG_SHA}; do \
      git -C /opt/third_party_cache/spdlog fetch --depth 1 origin "${sha}"; \
    done

ARG InfiniCore_BRANCH=main
ARG InfiniCore_SHA
RUN git clone https://github.com/InfiniTensor/InfiniCore.git && \
    cd InfiniCore && \
    git fetch origin ${InfiniCore_BRANCH} && \
    git checkout ${InfiniCore_SHA:-origin/${InfiniCore_BRANCH}} && \
    git submodule update --init --recursive submodules

WORKDIR /workspace/InfiniCore

RUN mkdir -p third_party && \
    rm -rf third_party/flash-attention third_party/cutlass && \
    ln -s /opt/third_party_cache/flash-attention third_party/flash-attention && \
    ln -s /opt/third_party_cache/cutlass third_party/cutlass

RUN set -eux; \
    JSON_SHA="$(git rev-parse HEAD:third_party/nlohmann_json)"; \
    SPDLOG_SHA="$(git rev-parse HEAD:third_party/spdlog)"; \
    rm -rf third_party/nlohmann_json third_party/spdlog; \
    git clone --shared /opt/third_party_cache/json third_party/nlohmann_json; \
    git -C third_party/nlohmann_json checkout "${JSON_SHA}"; \
    git clone --shared /opt/third_party_cache/spdlog third_party/spdlog; \
    git -C third_party/spdlog checkout "${SPDLOG_SHA}"

RUN xmake repo -u

# Base image links libmusa.so.4 to an empty libmusa.so.4.3.1 stub.
RUN ln -sf libmusa.so.4.3.5 /usr/lib/x86_64-linux-gnu/libmusa.so.4

RUN xmake f -y --moore-gpu=y --ccl=y --graph=y -cv
RUN xmake build -y && xmake install && xmake build -y _infinicore && xmake install _infinicore && pip install -e .

WORKDIR /workspace/InfiniLM

COPY . ./

RUN set -eux; \
    JSON_SHA="$(git rev-parse HEAD:third_party/json)"; \
    SPDLOG_SHA="$(git rev-parse HEAD:third_party/spdlog)"; \
    rm -rf third_party/json third_party/spdlog; \
    git clone --shared /opt/third_party_cache/json third_party/json; \
    git -C third_party/json checkout "${JSON_SHA}"; \
    git clone --shared /opt/third_party_cache/spdlog third_party/spdlog; \
    git -C third_party/spdlog checkout "${SPDLOG_SHA}"

RUN xmake build -y _infinilm && xmake install _infinilm && pip install -e .

WORKDIR /workspace
