ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.12-py3
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    http_proxy=${http_proxy} \
    https_proxy=${https_proxy}

ARG APT_MIRROR
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s|http://[^/]*/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        cmake \
        ninja-build \
        curl \
        tar \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_INDEX_URL
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    transformers \
    pyyaml \
    uvicorn \
    janus \
    fastapi \
    openai

ENV XMAKE_ROOT=y
RUN curl -fsSL https://xmake.io/shget.text | bash
ENV PATH="/root/.local/bin:/root/.xmake/bin:${PATH}"

ENV CPATH=/usr/local/cuda/include
ENV LIBRARY_PATH=/usr/local/cuda/lib64:$LIBRARY_PATH
ENV INFINI_ROOT="/root/.infinici"
ENV LD_LIBRARY_PATH="$INFINI_ROOT/lib:$LD_LIBRARY_PATH"
ENV PYTHONPATH="/root/.infinici/lib:$PYTHONPATH"

WORKDIR /workspace

ARG InfiniCore_BRANCH=main
ARG InfiniCore_SHA
RUN git clone --recursive https://github.com/InfiniTensor/InfiniCore.git && \
    cd InfiniCore && \
    git fetch origin ${InfiniCore_BRANCH} && \
    git checkout ${InfiniCore_SHA:-origin/${InfiniCore_BRANCH}}

WORKDIR /workspace/InfiniCore

WORKDIR /workspace/InfiniCore/third_party

RUN git clone https://github.com/Dao-AILab/flash-attention.git && \
    git clone https://github.com/NVIDIA/cutlass.git && \
    cd flash-attention && \
    git checkout 10846960ca0793b993446f6dbaf696479c127a9d && \
    cd ../cutlass && \
    git checkout 087c84df83d254b5fb295a7a408f1a1d554085cf

ENV CUTLASS_HOME=/workspace/InfiniCore/third_party/cutlass/
ENV PATH=${CUTLASS_HOME}:${PATH}

WORKDIR /workspace/InfiniCore

# Docker build has nvcc but no GPU driver/nvidia-smi; set CUDA arch explicitly.
ARG CUDA_ARCH=sm_80,sm_86,sm_89,sm_90
RUN xmake f -y --nv-gpu=y --ccl=y --graph=y --aten=y --cuda_arch=${CUDA_ARCH} --flash-attn=/workspace/InfiniCore/third_party/flash-attention -cv
RUN xmake build -y && xmake install && xmake build -y _infinicore && xmake install _infinicore && pip install -e .

WORKDIR /workspace/InfiniLM

COPY . ./

RUN xmake build -y _infinilm && xmake install _infinilm && pip install -e .

WORKDIR /root

COPY .ci/images/nvidia/.bashrc ./

WORKDIR /workspace
