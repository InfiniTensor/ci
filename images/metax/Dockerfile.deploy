ARG BASE_IMAGE=cr.metax-tech.com/public-ai-release/maca/vllm-metax:0.10.2-maca.ai3.2.1.7-torch2.6-py310-ubuntu22.04-amd64
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/conda/bin:${PATH}"

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    http_proxy=${http_proxy} \
    https_proxy=${https_proxy}

ARG APT_MIRROR
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s|http://[^/]*/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        cmake \
        ninja-build \
        curl \
        tar \
        unzip \
        libboost-dev \
        libboost-stacktrace-dev \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN python -m pip install --no-cache-dir --upgrade pip -i "${PIP_INDEX_URL}" && \
    python -m pip install --no-cache-dir -i "${PIP_INDEX_URL}" \
        transformers \
        pyyaml \
        uvicorn \
        janus \
        fastapi \
        openai

ENV XMAKE_ROOT=y
RUN curl -fsSL https://xmake.io/shget.text | bash
ENV PATH="/root/.local/bin:/root/.xmake/bin:${PATH}"

# MetaX build/runtime environment (canonical; mirrors images/metax/env-set.sh for local source)
ENV INFINI_ROOT=/root/.infini \
    MACA_HOME=/opt/maca \
    MACA_PATH=/opt/maca
ENV PATH="${PATH}:${INFINI_ROOT}/bin"
ENV TORCH_LIB=/opt/conda/lib/python3.10/site-packages/torch/lib
ENV LD_LIBRARY_PATH="${INFINI_ROOT}/lib:${MACA_PATH}/lib:/opt/conda/lib:${TORCH_LIB}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
ENV FLASH_ATTN_2_CUDA_SO=/opt/conda/lib/python3.10/site-packages/flash_attn_2_cuda.cpython-310-x86_64-linux-gnu.so
ENV CPATH=/opt/maca/tools/cu-bridge/include:/opt/maca/include/common:/opt/maca/include/mcblas:/opt/maca/include/mcsolver:/opt/maca/include/mcsparse:/opt/maca/include/mcr:/opt/maca/include:/opt/conda/include/python3.10:/opt/conda/include:/opt/conda/lib/python3.10/site-packages/pybind11/include:${CPATH:-}
ENV C_INCLUDE_PATH=${CPATH}
ENV CPLUS_INCLUDE_PATH=${CPATH}
ENV PYTHONPATH=/workspace/InfiniLM/python:/workspace/InfiniCore/python:${PYTHONPATH:-}

WORKDIR /workspace

RUN git_proxy="${https_proxy:-${HTTPS_PROXY:-}}"; \
    if [ -n "$git_proxy" ]; then \
      git config --global http.proxy "$git_proxy"; \
      git config --global https.proxy "$git_proxy"; \
    fi; \
    git config --global http.postBuffer 524288000; \
    git config --global http.version HTTP/1.1

# Pin third_party deps in a stable cache layer; only rebuilds when SHAs change.
# json/spdlog are fetched here once (via build proxy); pybind11 zip for xmake is cached here too.
ARG FLASH_ATTENTION_SHA=10846960ca0793b993446f6dbaf696479c127a9d
ARG CUTLASS_SHA=087c84df83d254b5fb295a7a408f1a1d554085cf
ARG PYBIND11_VERSION=v3.0.4
ARG GIT_NETWORK_RETRIES=5
RUN set -eux; \
    git_with_retry() { \
      attempts="${GIT_NETWORK_RETRIES:-5}"; \
      i=1; \
      while [ "$i" -le "$attempts" ]; do \
        if "$@"; then return 0; fi; \
        echo "git failed (attempt ${i}/${attempts}): $*" >&2; \
        sleep $((i * 10)); \
        i=$((i + 1)); \
      done; \
      return 1; \
    }; \
    git_clone_with_retry() { \
      url="$1"; dest="$2"; depth="${3:-}"; \
      rm -rf "$dest"; \
      if [ -n "$depth" ]; then \
        git_with_retry git clone --depth "$depth" "$url" "$dest"; \
      else \
        git_with_retry git clone "$url" "$dest"; \
      fi; \
    }; \
    mkdir -p /opt/third_party_cache; \
    git_clone_with_retry https://github.com/Dao-AILab/flash-attention.git /opt/third_party_cache/flash-attention; \
    git -C /opt/third_party_cache/flash-attention checkout ${FLASH_ATTENTION_SHA}; \
    git_clone_with_retry https://github.com/NVIDIA/cutlass.git /opt/third_party_cache/cutlass; \
    git -C /opt/third_party_cache/cutlass checkout ${CUTLASS_SHA}; \
    git_clone_with_retry https://github.com/nlohmann/json.git /opt/third_party_cache/json 1; \
    git_clone_with_retry https://github.com/gabime/spdlog.git /opt/third_party_cache/spdlog 1; \
    mkdir -p /opt/third_party_cache/xmake_pkg_search; \
    curl -fsSL -o /opt/third_party_cache/xmake_pkg_search/${PYBIND11_VERSION}.zip \
      "https://github.com/pybind/pybind11/archive/refs/tags/${PYBIND11_VERSION}.zip"

ARG InfiniCore_BRANCH=main
ARG InfiniCore_SHA
RUN set -eux; \
    git_with_retry() { \
      attempts="${GIT_NETWORK_RETRIES:-5}"; \
      i=1; \
      while [ "$i" -le "$attempts" ]; do \
        if "$@"; then return 0; fi; \
        echo "git failed (attempt ${i}/${attempts}): $*" >&2; \
        sleep $((i * 10)); \
        i=$((i + 1)); \
      done; \
      return 1; \
    }; \
    git_clone_with_retry() { \
      url="$1"; dest="$2"; \
      rm -rf "$dest"; \
      git_with_retry git clone "$url" "$dest"; \
    }; \
    git_clone_with_retry https://github.com/InfiniTensor/InfiniCore.git /workspace/InfiniCore; \
    cd /workspace/InfiniCore; \
    git_with_retry git fetch origin ${InfiniCore_BRANCH}; \
    git checkout ${InfiniCore_SHA:-origin/${InfiniCore_BRANCH}}; \
    git_with_retry git submodule update --init --recursive submodules

WORKDIR /workspace/InfiniCore

RUN mkdir -p third_party && \
    rm -rf third_party/flash-attention third_party/cutlass && \
    ln -s /opt/third_party_cache/flash-attention third_party/flash-attention && \
    ln -s /opt/third_party_cache/cutlass third_party/cutlass

RUN rm -rf third_party/nlohmann_json third_party/spdlog && \
    git clone --shared /opt/third_party_cache/json third_party/nlohmann_json && \
    git clone --shared /opt/third_party_cache/spdlog third_party/spdlog

RUN xmake repo -u

COPY .ci/images/install_xmake_pybind11.sh /usr/local/bin/install_xmake_pybind11.sh
RUN chmod +x /usr/local/bin/install_xmake_pybind11.sh && install_xmake_pybind11.sh

RUN echo "=== Clean InfiniCore ==="
RUN xmake clean -a || true
RUN rm -rf build .xmake || true

RUN echo "=== Build+install InfiniCore ==="
RUN python scripts/install.py --metax-gpu=y --use-mc=y --aten=y --flash-attn=. --ccl=y --graph=y
RUN python -m pip install -e . -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN xmake build -y infinicore_cpp_api && xmake install -y infinicore_cpp_api
RUN xmake build -y _infinicore && xmake install -y _infinicore

WORKDIR /workspace/InfiniLM

COPY . ./

RUN rm -rf third_party/json third_party/spdlog && \
    git clone --shared /opt/third_party_cache/json third_party/json && \
    git clone --shared /opt/third_party_cache/spdlog third_party/spdlog

RUN echo "=== Clean InfiniLM ==="
RUN xmake clean -a || true
RUN rm -rf build .xmake || true

RUN echo "=== Build+install InfiniLM ==="
RUN xmake build _infinilm && xmake install _infinilm
RUN python -m pip install -e . --no-build-isolation -i https://pypi.tuna.tsinghua.edu.cn/simple

WORKDIR /workspace
