ARG BASE_IMAGE=cambricon/pytorch:v1.25.3-torch2.1-anolisos8.8-py310
FROM ${BASE_IMAGE}

ENV PATH="/usr/local/python3.10/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/python3.10/lib:${LD_LIBRARY_PATH}"

RUN ln -sf python3.10 /usr/local/python3.10/bin/python3 && \
    ln -sf python3.10 /usr/local/python3.10/bin/python

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

RUN dnf install -y dnf-plugins-core && \
    (dnf config-manager --set-enabled powertools || dnf config-manager --set-enabled crb || true) && \
    dnf install -y \
        git \
        cmake \
        ninja-build \
        curl \
        tar \
        gcc \
        gcc-c++ \
        make \
        pkgconf-pkg-config \
        ca-certificates \
        boost-devel \
        boost-stacktrace \
        libffi-devel \
        openssl-devel \
        zlib-devel \
        bzip2-devel \
        readline-devel \
        sqlite-devel \
        ncurses-devel \
        xz-devel \
        expat-devel \
    && dnf clean all

# Base image only ships static libpython3.10.a; build shared libpython for pybind11 modules.
ARG PYTHON_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/python
RUN PY_PREFIX=/usr/local/python3.10 && \
    PY_LIB="${PY_PREFIX}/lib" && \
    PYTHON_VER=$(python3.10 -c 'import sys; print("%s.%s.%s" % sys.version_info[:3])') && \
    PYTHON_MM=$(python3.10 -c 'import sys; print("%s.%s" % sys.version_info[:2])') && \
    curl -fsSL "${PYTHON_MIRROR}/${PYTHON_VER}/Python-${PYTHON_VER}.tgz" -o /tmp/Python.tgz && \
    tar xzf /tmp/Python.tgz -C /tmp && \
    cd "/tmp/Python-${PYTHON_VER}" && \
    ./configure --prefix="${PY_PREFIX}" --enable-shared --with-system-ffi \
        CFLAGS="-fPIC" LDFLAGS="-Wl,-rpath=${PY_PREFIX}/lib" && \
    make -j"$(nproc)" "libpython${PYTHON_MM}.so" && \
    cp -a libpython*.so* "${PY_LIB}/" && \
    SO_FILE=$(ls "${PY_LIB}/libpython${PYTHON_MM}.so."* | head -1) && \
    ln -sf "$(basename "${SO_FILE}")" "${PY_LIB}/libpython${PYTHON_MM}.so" && \
    if [ -f "${PY_LIB}/libpython${PYTHON_MM}.a" ]; then \
        mv "${PY_LIB}/libpython${PYTHON_MM}.a" "${PY_LIB}/libpython${PYTHON_MM}.a.static"; \
    fi && \
    echo "${PY_PREFIX}/lib" > /etc/ld.so.conf.d/cambricon-python310.conf && \
    ldconfig && \
    rm -rf /tmp/Python*

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip config set global.index-url "${PIP_INDEX_URL}" && \
    pip install --no-cache-dir --upgrade pip setuptools wheel -i "${PIP_INDEX_URL}" && \
    pip install --no-cache-dir -i "${PIP_INDEX_URL}" \
        transformers \
        pyyaml \
        uvicorn \
        janus \
        fastapi \
        openai \
        pybind11 \
        xxhash \
        ml_dtypes \
        datasets \
        Pillow

ENV XMAKE_ROOT=y
RUN curl -fsSL https://xmake.io/shget.text | bash
ENV PATH="/root/.local/bin:/root/.xmake/bin:${PATH}"

ENV INFINI_ROOT="/root/.infini"
ENV LD_LIBRARY_PATH="/usr/local/python3.10/lib:$INFINI_ROOT/lib:$LD_LIBRARY_PATH"
ENV PYTHONPATH="/root/.infini/lib:$PYTHONPATH"

WORKDIR /workspace

ARG InfiniCore_BRANCH
RUN RUN git config --global --unset-all url.git@github.com:.insteadof || true && \
        git clone --recursive https://github.com/Vincent777/InfiniCore.git

WORKDIR /workspace/InfiniCore

RUN git fetch origin ${InfiniCore_BRANCH} && git checkout ${InfiniCore_BRANCH}

RUN xmake repo -u

RUN rm -rf /root/.xmake/cache/packages/*/p/python* /root/.xmake/packages/p/python*
RUN xmake f -y --cambricon-mlu=y --ccl=y -c -cv
RUN xmake build -y && xmake install && xmake build -y _infinicore && xmake install _infinicore && pip install -e . -i "${PIP_INDEX_URL}"

WORKDIR /workspace/InfiniLM

COPY . ./

RUN xmake build -y _infinilm && xmake install _infinilm && pip install -e . -i "${PIP_INDEX_URL}"

WORKDIR /workspace
