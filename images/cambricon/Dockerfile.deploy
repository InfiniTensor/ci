ARG BASE_IMAGE=cambricon/pytorch:v1.25.3-torch2.1-anolisos8.8-py310
FROM ${BASE_IMAGE}

COPY .ci/images/cambricon/patch-xmake-python.py /usr/local/bin/patch-xmake-python.py

ENV PATH="/usr/local/python3.10/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/python3.10/lib:${LD_LIBRARY_PATH}"

RUN ln -sf python3.10 /usr/local/python3.10/bin/python3 && \
    ln -sf python3.10 /usr/local/python3.10/bin/python

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

RUN dnf install -y dnf-plugins-core && \
    (dnf config-manager --set-enabled powertools || dnf config-manager --set-enabled crb || true) && \
    dnf install -y \
        git \
        cmake \
        ninja-build \
        curl \
        tar \
        gcc \
        gcc-c++ \
        make \
        pkgconf-pkg-config \
        ca-certificates \
        boost-devel \
        boost-stacktrace \
        libffi-devel \
        openssl-devel \
    && dnf clean all

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip config set global.index-url "${PIP_INDEX_URL}" && \
    pip install --no-cache-dir --upgrade pip setuptools wheel -i "${PIP_INDEX_URL}" && \
    pip install --no-cache-dir -i "${PIP_INDEX_URL}" \
        transformers \
        pyyaml \
        uvicorn \
        janus \
        fastapi \
        openai \
        pybind11 \
        xxhash \
        ml_dtypes \
        datasets

ENV XMAKE_ROOT=y
RUN curl -fsSL https://xmake.io/shget.text | bash
ENV PATH="/root/.local/bin:/root/.xmake/bin:${PATH}"

ENV INFINI_ROOT="/root/.infini"
ENV LD_LIBRARY_PATH="/usr/local/python3.10/lib:$INFINI_ROOT/lib:$LD_LIBRARY_PATH"
ENV PYTHONPATH="/root/.infini/lib:$PYTHONPATH"

# Static libpython3.10.a cannot be linked into .so modules (non-PIC on aarch64).
# Force shared libpython for xmake/pybind11, and wrap g++ for -ldl on link steps.
RUN PY_LIB=/usr/local/python3.10/lib && \
    if [ -f "${PY_LIB}/libpython3.10.so.1.0" ] && [ ! -e "${PY_LIB}/libpython3.10.so" ]; then \
        ln -sf libpython3.10.so.1.0 "${PY_LIB}/libpython3.10.so"; \
    fi && \
    if ls ${PY_LIB}/libpython3.10.so* >/dev/null 2>&1 && [ -f ${PY_LIB}/libpython3.10.a ]; then \
        mv ${PY_LIB}/libpython3.10.a ${PY_LIB}/libpython3.10.a.static; \
    fi && \
    for gxx in /usr/local/gcc-11.4.0/bin/g++ /usr/local/gcc-11.4.0/bin/c++ /usr/bin/g++ /usr/bin/c++; do \
        [ -x "$gxx" ] || continue; \
        [ -x "${gxx}.real" ] && continue; \
        mv "$gxx" "${gxx}.real"; \
        printf '%s\n' \
            '#!/bin/sh' \
            "real=\"${gxx}.real\"" \
            'for arg in "$@"; do' \
            '  case "$arg" in -c|-E|-S|-M|-MM) exec "$real" "$@" ;; esac' \
            'done' \
            'exec "$real" "$@" -ldl -lpthread -lutil' \
            > "$gxx"; \
        chmod +x "$gxx"; \
    done

WORKDIR /workspace

ARG InfiniCore_BRANCH
RUN git clone --recursive https://github.com/Vincent777/InfiniCore.git

WORKDIR /workspace/InfiniCore

RUN git fetch origin ${InfiniCore_BRANCH} && git checkout ${InfiniCore_BRANCH}

# Cambricon ships static libpython only; link pybind11 modules without libpython.a.
RUN python3 /usr/local/bin/patch-xmake-python.py xmake.lua

RUN xmake repo -u

RUN rm -rf /root/.xmake/cache/packages/*/p/python* /root/.xmake/packages/p/python*
RUN xmake f -y --cambricon-mlu=y --ccl=y -c -cv
RUN xmake build -y && xmake install && xmake build -y _infinicore && xmake install _infinicore && pip install -e . -i "${PIP_INDEX_URL}"

WORKDIR /workspace/InfiniLM

COPY . ./

RUN python3 /usr/local/bin/patch-xmake-python.py xmake.lua && \
    if [ -f xmake.lua ]; then \
        rm -rf /root/.xmake/cache/packages/*/p/python* /root/.xmake/packages/p/python*; \
        xmake f -y -c -cv; \
    fi

RUN xmake build -y _infinilm && xmake install _infinilm && pip install -e . -i "${PIP_INDEX_URL}"

WORKDIR /workspace
