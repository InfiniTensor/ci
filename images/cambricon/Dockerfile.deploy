ARG BASE_IMAGE=cambricon/pytorch:v1.25.3-torch2.1-anolisos8.8-py310
FROM ${BASE_IMAGE}

ENV PATH="/usr/local/python3.10/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/python3.10/lib:${LD_LIBRARY_PATH}"

RUN ln -sf python3.10 /usr/local/python3.10/bin/python3 && \
    ln -sf python3.10 /usr/local/python3.10/bin/python

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    http_proxy=${http_proxy} \
    https_proxy=${https_proxy}

RUN dnf install -y dnf-plugins-core && \
    (dnf config-manager --set-enabled powertools || dnf config-manager --set-enabled crb || true) && \
    dnf install -y \
        git \
        cmake \
        ninja-build \
        curl \
        tar \
        gcc \
        gcc-c++ \
        make \
        pkgconf-pkg-config \
        ca-certificates \
        boost-devel \
        boost-stacktrace \
        libffi-devel \
        openssl-devel \
        zlib-devel \
        bzip2-devel \
        readline-devel \
        sqlite-devel \
        ncurses-devel \
        xz-devel \
        expat-devel \
    && dnf clean all

# Base image only ships static libpython3.10.a; build shared libpython for pybind11 modules.
ARG PYTHON_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/python
RUN PY_PREFIX=/usr/local/python3.10 && \
    PY_LIB="${PY_PREFIX}/lib" && \
    PYTHON_VER=$(python3.10 -c 'import sys; print("%s.%s.%s" % sys.version_info[:3])') && \
    PYTHON_MM=$(python3.10 -c 'import sys; print("%s.%s" % sys.version_info[:2])') && \
    curl -fsSL "${PYTHON_MIRROR}/${PYTHON_VER}/Python-${PYTHON_VER}.tgz" -o /tmp/Python.tgz && \
    tar xzf /tmp/Python.tgz -C /tmp && \
    cd "/tmp/Python-${PYTHON_VER}" && \
    ./configure --prefix="${PY_PREFIX}" --enable-shared --with-system-ffi \
        CFLAGS="-fPIC" LDFLAGS="-Wl,-rpath=${PY_PREFIX}/lib" && \
    make -j"$(nproc)" "libpython${PYTHON_MM}.so" && \
    cp -a libpython*.so* "${PY_LIB}/" && \
    SO_FILE=$(ls "${PY_LIB}/libpython${PYTHON_MM}.so."* | head -1) && \
    ln -sf "$(basename "${SO_FILE}")" "${PY_LIB}/libpython${PYTHON_MM}.so" && \
    if [ -f "${PY_LIB}/libpython${PYTHON_MM}.a" ]; then \
        mv "${PY_LIB}/libpython${PYTHON_MM}.a" "${PY_LIB}/libpython${PYTHON_MM}.a.static"; \
    fi && \
    echo "${PY_PREFIX}/lib" > /etc/ld.so.conf.d/cambricon-python310.conf && \
    ldconfig && \
    rm -rf /tmp/Python*

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip config set global.index-url "${PIP_INDEX_URL}" && \
    pip install --no-cache-dir --upgrade pip "setuptools<82" wheel -i "${PIP_INDEX_URL}" && \
    pip install --no-cache-dir -i "${PIP_INDEX_URL}" \
        transformers \
        pyyaml \
        uvicorn \
        janus \
        fastapi \
        openai \
        pybind11 \
        xxhash \
        ml_dtypes \
        datasets \
        Pillow

ENV XMAKE_ROOT=y
RUN curl -fsSL https://xmake.io/shget.text | bash
ENV PATH="/root/.local/bin:/root/.xmake/bin:${PATH}"

ENV INFINI_ROOT="/root/.infini"
ENV LD_LIBRARY_PATH="/usr/local/python3.10/lib:$INFINI_ROOT/lib:$LD_LIBRARY_PATH"
ENV PYTHONPATH="/root/.infini/lib:$PYTHONPATH"

WORKDIR /workspace

RUN git config --global --unset-all url.git@github.com:.insteadof || true && \
    git config --global http.proxy "${http_proxy}" && \
    git config --global https.proxy "${https_proxy}"

# Pin third_party deps in a stable cache layer; only rebuilds when SHAs change.
# json/spdlog are fetched here once (via build proxy); later stages clone locally from cache only.
ARG FLASH_ATTENTION_SHA=10846960ca0793b993446f6dbaf696479c127a9d
ARG CUTLASS_SHA=087c84df83d254b5fb295a7a408f1a1d554085cf
ARG INFINICORE_NLOHMANN_JSON_SHA=55f93686c01528224f448c19128836e7df245f72
ARG INFINICORE_SPDLOG_SHA=f1d748e5e3edfa4b1778edea003bac94781bc7b7
ARG INFINILM_JSON_SHA=5ed07097faa6c50199c4a3b66e5ed37d4fbfccc2
ARG INFINILM_SPDLOG_SHA=88a0e07ad5bb3e2651cd5613530b3f06a15fc400
RUN mkdir -p /opt/third_party_cache && \
    git clone https://github.com/Dao-AILab/flash-attention.git /opt/third_party_cache/flash-attention && \
    git -C /opt/third_party_cache/flash-attention checkout ${FLASH_ATTENTION_SHA} && \
    git clone https://github.com/NVIDIA/cutlass.git /opt/third_party_cache/cutlass && \
    git -C /opt/third_party_cache/cutlass checkout ${CUTLASS_SHA} && \
    git clone https://github.com/nlohmann/json.git /opt/third_party_cache/json && \
    git clone https://github.com/gabime/spdlog.git /opt/third_party_cache/spdlog && \
    for sha in ${INFINICORE_NLOHMANN_JSON_SHA} ${INFINILM_JSON_SHA}; do \
      git -C /opt/third_party_cache/json fetch --depth 1 origin "${sha}"; \
    done && \
    for sha in ${INFINICORE_SPDLOG_SHA} ${INFINILM_SPDLOG_SHA}; do \
      git -C /opt/third_party_cache/spdlog fetch --depth 1 origin "${sha}"; \
    done

ARG InfiniCore_BRANCH=main
ARG InfiniCore_SHA
RUN git clone https://github.com/InfiniTensor/InfiniCore.git && \
    cd InfiniCore && \
    git fetch origin ${InfiniCore_BRANCH} && \
    git checkout ${InfiniCore_SHA:-origin/${InfiniCore_BRANCH}} && \
    git submodule update --init --recursive submodules

WORKDIR /workspace/InfiniCore

RUN mkdir -p third_party && \
    rm -rf third_party/flash-attention third_party/cutlass && \
    ln -s /opt/third_party_cache/flash-attention third_party/flash-attention && \
    ln -s /opt/third_party_cache/cutlass third_party/cutlass

RUN set -eux; \
    JSON_SHA="$(git rev-parse HEAD:third_party/nlohmann_json)"; \
    SPDLOG_SHA="$(git rev-parse HEAD:third_party/spdlog)"; \
    rm -rf third_party/nlohmann_json third_party/spdlog; \
    git clone --shared /opt/third_party_cache/json third_party/nlohmann_json; \
    git -C third_party/nlohmann_json checkout "${JSON_SHA}"; \
    git clone --shared /opt/third_party_cache/spdlog third_party/spdlog; \
    git -C third_party/spdlog checkout "${SPDLOG_SHA}"

RUN xmake repo -u

RUN rm -rf /root/.xmake/cache/packages/*/p/python* /root/.xmake/packages/p/python*
RUN xmake f -y --cambricon-mlu=y --ccl=y -c -cv
RUN xmake build -y && xmake install && xmake build -y _infinicore && xmake install _infinicore && pip install -e . -i "${PIP_INDEX_URL}"

WORKDIR /workspace/InfiniLM

COPY . ./

RUN set -eux; \
    JSON_SHA="$(git rev-parse HEAD:third_party/json)"; \
    SPDLOG_SHA="$(git rev-parse HEAD:third_party/spdlog)"; \
    rm -rf third_party/json third_party/spdlog; \
    git clone --shared /opt/third_party_cache/json third_party/json; \
    git -C third_party/json checkout "${JSON_SHA}"; \
    git clone --shared /opt/third_party_cache/spdlog third_party/spdlog; \
    git -C third_party/spdlog checkout "${SPDLOG_SHA}"

RUN xmake build -y _infinilm && xmake install _infinilm && pip install -e . -i "${PIP_INDEX_URL}"

WORKDIR /workspace
