ARG BASE_IMAGE=image.sourcefind.cn:5000/dcu/admin/base/pytorch:2.4.1-ubuntu22.04-dtk25.04.1-py3.10
FROM ${BASE_IMAGE}

# DTK env.sh uses bash syntax; default /bin/sh (dash) causes "Bad substitution".
SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

ARG APT_MIRROR
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s|http://[^/]*/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        cmake \
        ninja-build \
        curl \
        tar \
        build-essential \
        pkg-config \
        python3-dev \
        ca-certificates \
        libboost-dev \
        libboost-stacktrace-dev \
        libffi-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_INDEX_URL
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        transformers \
        pyyaml \
        uvicorn \
        janus \
        fastapi \
        openai \
        pybind11 \
        xxhash \
        ml_dtypes \
        datasets

ENV XMAKE_ROOT=y
RUN curl -fsSL https://xmake.io/shget.text | bash
ENV PATH="/root/.local/bin:/root/.xmake/bin:${PATH}"

ENV INFINI_ROOT="/root/.infini"
ENV LD_LIBRARY_PATH="$INFINI_ROOT/lib:$LD_LIBRARY_PATH"
RUN python -c 'import torch, os; print(os.path.join(os.path.dirname(torch.__file__), "lib"))' >> /etc/ld.so.conf.d/torch.conf && ldconfig
ENV PYTHONPATH="/root/.infini/lib:${PYTHONPATH:-}"

WORKDIR /workspace/InfiniLM

RUN xmake repo -u

COPY . ./

RUN source /opt/dtk/env.sh && source /opt/dtk/cuda/cuda-12/env.sh && \
    xmake build -y _infinilm && xmake install _infinilm && \
    INFINILM_ENABLE_HYGON=1 pip install -e . --no-build-isolation ${PIP_INDEX_URL:+-i "${PIP_INDEX_URL}"}

WORKDIR /workspace
